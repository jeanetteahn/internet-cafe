{
  "name": "weather-wallpaper",
  "version": "1.0.0",
  "description": "An Electron always-on live desktop wallpaper: background video with a live local weather overlay and a 5-panel auto-searching browser wall.",
  "main": "main.js",
  "scripts": {
    "start": "node scripts/launch-both.js",
    "start:wallpaper-only": "electron .",
    "start:kiosk-only": "electron kiosk-main.js",
    "build:linux": "electron-builder --linux AppImage"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.example.weatherwallpaper",
    "productName": "WeatherWallpaper",
    "linux": {
      "target": ["AppImage"],
      "category": "Utility"
    }
  }
}
